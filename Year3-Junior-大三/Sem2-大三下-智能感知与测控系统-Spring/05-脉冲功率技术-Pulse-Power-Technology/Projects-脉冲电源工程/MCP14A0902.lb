.SUBCKT MCP14A0902_S31 1 2 3 4 
S_S31         3 4 1 2 _S31
RS_S31         1 2 1G
.MODEL         _S31 VSWITCH Roff=100MEG Ron=1k Voff=0.2V Von=0.1V
.ends MCP14A0902_S31
.SUBCKT MCP14A0902_H60 1 2 3 4
H_H60         3 4 VH_H60 1
VH_H60         1 2 0V
.ends MCP14A0902_H60
.SUBCKT MCP14A0902_H67 1 2 3 4
H_H67         3 4 VH_H67 1
VH_H67         1 2 0V
.ends MCP14A0902_H67
.SUBCKT COMPARATOR INP INM OUT  
EOUT OUT 0 VALUE { IF( V(INP)>V(INM),1,0) }
.ends COMPARATOR
.SUBCKT AND A B OUT 
EOUT OUT 0 VALUE { IF( V(A)>0.5 & V(B)>0.5,1,0) }
.ends AND
.SUBCKT ANALOG_DIFF IN1 IN2 OUT
EOUT OUT 0 VALUE { V(IN1)-V(IN2)}
.ends ANALOG_DIFF
.SUBCKT COMP_HYS INP INM HYS OUT PARAMs: T=10
EIN INP1 INM1 INP INM 1
EHYS INP1 INP2 VALUE { IF( V(1)>0.5,-V(HYS)/2,V(HYS)/2) }
EOUT OUT 0 VALUE { IF( V(INP2)>V(INM1),1,0) }
R1 OUT 1 1
C1 1 0 {T*1e-9}
RINP1 INP1 0 1K
.ends COMP_HYS
.SUBCKT NOR A B OUT
EOUT OUT 0 VALUE { IF( V(A)>0.5 | V(B)>0.5,0,1) }
.ends NOR
.SUBCKT XOR A B OUT
EOUT OUT 0 VALUE { IF( (V(A)>0.5 & V(B)<0.5) | (V(A)<0.5 & V(B)>0.5),1,0) }
.ends XOR

.ENDS MCP14A0902

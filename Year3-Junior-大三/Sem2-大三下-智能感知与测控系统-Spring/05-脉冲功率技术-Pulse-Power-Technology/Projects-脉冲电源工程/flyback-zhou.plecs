      Parameter {
        Variable      "StartFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "if (sin>100)\n"
"{\n"
"\tsout =  120;\n"
"}\n"
"else if (sin > 10)\n"
"{\n"
"\tsout =  sin * 1.5 ;\n"
"}\n"
"else if ( sin > 0)\n"
"{\n"
"\tsout = 20;\n"
"}\n"
"else \n"
"{\n"
"\tsout = 0;\n"
"}\n"
"Output (0) = sout;"
        Show          off
      }
